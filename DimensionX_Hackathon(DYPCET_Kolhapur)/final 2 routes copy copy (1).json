        "responses": {
          "values": [
            {
              "content": "=You are an AI assistant for a college scholarship office. Write a congratulatory email (max 80 words) to inform a student that their scholarship application has been approved.\n\nStudent Name: {{ $('Prepare Student Data').item.json.student_name }}\nScholarship Type: {{ $('Prepare Student Data').item.json.scholarship_type }}\nApplication Status: Approved\n\nRules:\n- Warm and congratulatory tone\n- Mention next steps for receiving the scholarship\n- Professional but celebratory\n- No emojis\n- Return ONLY a valid JSON object with exactly this structure: {\"subject\": \"your subject here\", \"body\": \"your email body here\"}\n- Do not include any markdown formatting, code blocks, or extra text"
            }
          ]
