# ==========================================
# SkillPilot AI - Backend Environment Template
# ==========================================

# Application Settings
APP_NAME="SkillPilot AI"
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# Strands Decider 2B Settings
# URL of running strands-decider server (/v1/systemone)
STRANDS_DECIDER_URL=http://127.0.0.1:8000/v1/systemone
STRANDS_DECIDER_MODEL=StrandsAgents/strands-decider-2B-hobson-v19
DECIDER_CONFIDENCE_THRESHOLD=0.65
DECIDER_TIMEOUT_SECONDS=4.0

# Amazon Bedrock Settings
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# AWS Credentials (Optional if configured via `aws configure` or IAM roles)
# Do not commit real keys to git!
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Storage Settings
STORAGE_TYPE=json
